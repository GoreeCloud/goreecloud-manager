{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Glaze UI",
    "version": "1.0.0",
    "principle": "Preserve visual delight while standardizing semantics, accessibility, and behavior."
  },
  "color": {
    "light": {
      "canvas": "#EEF3F9",
      "canvasAccent": "#F8FBFF",
      "surface": "rgba(255,255,255,0.76)",
      "surfaceStrong": "rgba(255,255,255,0.94)",
      "surfaceMuted": "rgba(244,247,251,0.86)",
      "text": "#172033",
      "muted": "#67748A",
      "line": "rgba(95,116,146,0.16)",
      "accent": "#366CF6",
      "accentSecondary": "#7C5CFF",
      "success": "#197A4B",
      "warning": "#A15C00",
      "danger": "#B42318"
    },
    "dark": {
      "canvas": "#0D1119",
      "canvasAccent": "#121824",
      "surface": "rgba(25,32,45,0.78)",
      "surfaceStrong": "rgba(24,31,44,0.96)",
      "surfaceMuted": "rgba(31,39,54,0.86)",
      "text": "#F3F6FB",
      "muted": "#A1AEC0",
      "line": "rgba(193,207,229,0.12)",
      "accent": "#7AA2FF",
      "accentSecondary": "#A594FF",
      "success": "#73D9A2",
      "warning": "#F7C36C",
      "danger": "#FF8A80"
    }
  },
  "space": {"1":4,"2":8,"3":12,"4":16,"5":20,"6":24,"8":32,"10":40,"12":48,"16":64},
  "radius": {"sm":10,"md":14,"control":16,"lg":22,"xl":28,"2xl":32,"pill":999},
  "target": {"minimum":44,"comfortable":48},
  "blur": {"glaze":22,"overlay":28},
  "shadow": {
    "soft":"0 8px 30px rgba(37,55,82,0.05)",
    "raised":"0 18px 48px rgba(37,55,82,0.09)",
    "darkRaised":"0 18px 54px rgba(0,0,0,0.24)"
  },
  "motion": {
    "instant":90,
    "fast":160,
    "standard":220,
    "emphasized":320,
    "easeStandard":"cubic-bezier(0.2,0,0,1)",
    "easeEmphasized":"cubic-bezier(0.2,0.8,0.2,1)"
  },
  "breakpoint": {"compactMax":599,"mediumMin":600,"expandedMin":1024,"wideMin":1440},
  "focus": {"width":3,"offset":2},
  "typography": {
    "family":"Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "body":16,
    "small":14,
    "label":13,
    "title":28,
    "display":38,
    "lineHeightBody":1.55
  }
}
