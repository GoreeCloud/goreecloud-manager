# GoreeCloud Manager non-secret configuration template.
# Copy to .env for local development. Never commit a populated .env file.

DJANGO_DEBUG=true
# Use DJANGO_SECRET_KEY only for local/isolated development. Long-lived deployment
# should leave it empty and set DJANGO_SECRET_KEY_FILE to an approved protected
# file-backed secret mount. The two sources are mutually exclusive, and production
# mode fails closed if neither provides a non-development secret.
DJANGO_SECRET_KEY=replace-with-a-unique-secret
DJANGO_SECRET_KEY_FILE=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
# Keep these disabled for direct loopback development. Enable them only when the
# approved private Caddy HTTPS path is in use and validated. HSTS preload is normally
# unnecessary for a private administrative service and should remain false unless a
# separately approved domain-wide decision requires it.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
GOREECLOUD_MANAGER_PORT=8090
# Bound the total time an authenticated Manager request waits for integration work.
# Individual adapters still keep their own network/artifact timeout and staleness rules.
MANAGER_INTEGRATION_BUDGET_SECONDS=7
# SQLite remains the current database for Manager's small private administrative
# workload. This bounded wait absorbs brief write contention without approaching the
# Gunicorn request timeout. Values above 20 seconds are rejected at startup.
DJANGO_SQLITE_TIMEOUT_SECONDS=10
# Manager keeps authentication sessions in the database. The default server-side
# expiration window is eight hours and may be configured only from 15 minutes through
# 24 hours. Browser-close expiry is enabled by default as an additional boundary.
# Ordinary read-only requests do not slide the expiration window because Manager does
# not save the session on every request. Invalid browser-close boolean text is rejected.
DJANGO_SESSION_COOKIE_AGE_SECONDS=28800
DJANGO_SESSION_EXPIRE_AT_BROWSER_CLOSE=true
# Optional outside Docker. Compose persists SQLite at /app/data/db.sqlite3.
# DJANGO_DB_PATH=/absolute/path/to/db.sqlite3

# GoreeCloud Privacy Shield read-only privacy-status integration.
# Manager reads only a sanitized Privacy Shield status document that conforms to
# contracts/privacy-shield.status.schema.json in GoreeCloud/goreecloud-privacy-shield.
# The status producer must explicitly exclude raw browsing/DNS/network activity,
# credentials, and identifying content. Mount the approved status artifact read-only.
# No producer or production mount is activated by this source configuration template.
PRIVACY_SHIELD_STATUS_FILE=

# NetBird read-only integration.
# Use the self-hosted management API base URL ending in /api and a least-privilege
# service-user personal access token. Keep the populated token only in protected
# environment-specific secret storage.
NETBIRD_ENABLED=false
NETBIRD_API_URL=https://netbird.goreecloud.com/api
NETBIRD_API_TOKEN=
NETBIRD_TIMEOUT_SECONDS=5

# Healthchecks read-only Management API integration.
# Create a project-specific read-only API key in Healthchecks Project Settings.
# The API URL should end at the API version root; Manager appends /checks/.
# In the VPS deployment, Manager reaches the Healthchecks application container
# directly over the dedicated external manager-healthchecks Docker network.
# The canonical host/proto preserve Healthchecks' existing host validation and
# external HTTPS application identity on the direct internal request path.
HEALTHCHECKS_ENABLED=false
HEALTHCHECKS_API_URL=http://healthchecks:8000/api/v3
HEALTHCHECKS_API_KEY=
HEALTHCHECKS_TIMEOUT_SECONDS=5
HEALTHCHECKS_CANONICAL_HOST=healthchecks.goreecloud.com
HEALTHCHECKS_FORWARDED_PROTO=https

# Uptime Kuma read-only monitoring visibility.
# Create a dedicated Uptime Kuma API key used only for the protected /metrics
# endpoint. Manager authenticates with an empty Basic Auth username and this key
# as the password. In the VPS deployment, both containers join the dedicated
# external manager-uptime network; no Uptime Kuma host port is published.
UPTIME_KUMA_ENABLED=false
UPTIME_KUMA_METRICS_URL=http://uptime-kuma:3001/metrics
UPTIME_KUMA_API_KEY=
UPTIME_KUMA_TIMEOUT_SECONDS=5

# Beszel native read-only resource visibility.
# A delegated host-side collector authenticates outside Manager with the dedicated
# Beszel readonly identity, reads only the explicitly shared system, and writes a
# sanitized non-secret artifact into BESZEL_STATUS_HOST_DIR. Manager receives no
# Beszel credential/token, Hub data, agent credential, or Docker socket.
# Local development uses ./runtime/beszel. The GoreeCloud VPS overrides this with
# /srv/docker/appdata/goreecloud-manager/integrations/beszel.
BESZEL_ENABLED=false
BESZEL_STATUS_HOST_DIR=./runtime/beszel
BESZEL_STATUS_PATH=/app/integrations/beszel/status.json
# The delegated collector is intended to refresh every five minutes. Mark the
# artifact stale after fifteen minutes and the underlying metric sample stale after
# thirty minutes unless the deployment intentionally changes those expectations.
BESZEL_STATUS_MAX_AGE_SECONDS=900
BESZEL_DATA_MAX_AGE_SECONDS=1800

# Kopia native read-only protection visibility.
# A delegated host-side collector writes only sanitized non-secret status into
# KOPIA_STATUS_HOST_DIR. Compose mounts that directory read-only at
# /app/integrations/kopia; Manager never receives Docker or Kopia credentials.
# Local development uses ./runtime/kopia. The GoreeCloud VPS overrides this with
# /srv/docker/appdata/goreecloud-manager/integrations/kopia.
KOPIA_ENABLED=false
KOPIA_STATUS_HOST_DIR=./runtime/kopia
KOPIA_STATUS_PATH=/app/integrations/kopia/status.json
# The backup timer runs every six hours with up to five minutes of randomized delay.
# Mark the collector path stale after eight hours and the latest snapshot stale after
# twelve hours unless the deployment intentionally changes those expectations.
KOPIA_STATUS_MAX_AGE_SECONDS=28800
KOPIA_SNAPSHOT_MAX_AGE_SECONDS=43200

# GoreeCloud Mesh read-only Platform Registry integration.
# Manager appends /v1/platform-registry and requires a GoreeCloud Identity service
# credential carrying only mesh.platform-registry.read. Do not grant Manager the
# mesh.platform-registry.write scope. A direct token is for isolated development only;
# long-lived environments should use an approved externally refreshed file-backed
# credential source. Manager rereads the file for each request and never stores the
# credential in its database or renders it in the UI.
#
# When Mesh is enabled, set an explicit maximum accepted age for producer observation
# and canonical conformance-evaluation timestamps. Manager intentionally has no hidden
# default freshness policy: deployment owners choose the bound appropriate to their
# publication cadence. Records older than this bound remain visible as historical
# producer state but are excluded from current favorable conformance, Stable-eligibility,
# and verified-restore summary counts. Future-dated records fail closed.
MESH_ENABLED=false
MESH_API_URL=
MESH_ACCESS_TOKEN=
MESH_ACCESS_TOKEN_FILE=
MESH_TIMEOUT_SECONDS=5
MESH_PLATFORM_RECORD_MAX_AGE_SECONDS=

# GoreeCloud Mesh live-only Platform refresh signaling.
# This is a separate least-privilege consumer from the Platform Registry path. When
# enabled, Manager appends /v1/events/stream and requests only the registered
# mesh.service.upserted.v1 and mesh.relationship.upserted.v1 types. The credential must
# carry only the dedicated mesh.events.read permission needed by this path; do not
# assume mesh.platform-registry.read or any Mesh write scope grants event access.
#
# The upstream Mesh transport is best-effort, non-durable, non-replayable, and bounded.
# Manager validates the closed event envelope server-side, emits only a minimal
# same-origin refresh signal, and then reloads the Platform Registry for authoritative
# state. A direct event token is for isolated development only. Long-lived environments
# should use the separately protected file-backed credential source.
MESH_EVENTS_ENABLED=false
MESH_EVENTS_ACCESS_TOKEN=
MESH_EVENTS_ACCESS_TOKEN_FILE=
MESH_EVENTS_BUFFER_SIZE=8
MESH_EVENTS_WINDOW_SECONDS=5

# Wardveil Security read-only status visibility through the Mesh evidence plane.
# Manager requests only producer=wardveil-security, authority_domain=security, and
# assertion=security-status. This credential is deliberately separate from both the
# Platform Registry and live-event credentials and must carry only mesh.evidence.read
# for this path. Mesh transport success is not a Wardveil security verdict; Manager
# preserves producer outcome and producer-declared validity without manufacturing a
# Protected claim. Direct credentials are for isolated development only; long-lived
# environments should use the separately protected file-backed credential source.
WARDVEIL_STATUS_ENABLED=false
MESH_WARDVEIL_EVIDENCE_TOKEN=
MESH_WARDVEIL_EVIDENCE_TOKEN_FILE=
WARDVEIL_STATUS_TIMEOUT_SECONDS=5

# GoreeCloud Tasks read-only operational-work integration.
# TASKS_API_URL is the GoreeCloud Tasks application base URL; Manager appends the
# dedicated /api/v1/manager/operational-tasks/ path. The bearer token maps inside
# Tasks to one explicitly configured Tasks integration account, whose current
# project memberships define exactly what Manager may read.
# A direct token is acceptable only for an isolated development .env. Long-lived
# deployment should use TASKS_ACCESS_TOKEN_FILE backed by approved protected secret
# storage. Set only one token source.
TASKS_ENABLED=false
TASKS_API_URL=
TASKS_ACCESS_TOKEN=
TASKS_ACCESS_TOKEN_FILE=
TASKS_TIMEOUT_SECONDS=5
